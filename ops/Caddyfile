api.voxagent.in {
	# Block scanner / bot probes
	@probe_paths path /.env* /.git* /wp-* *.php /admin/*
	@probe_headers header Next-Action *
	respond @probe_paths 403
	respond @probe_headers 403

	# Admin routes to core-api
	handle /v1/admin/redis* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3001
	}

	# Explicit Voice Bridge routes
	handle /bridge/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /auth/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /twilio/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /ws* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /health* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /internal/* {
		reverse_proxy 127.0.0.1:3000
	}
	# Root landing route: strictly GET/HEAD to bridge
	@root_get {
		method GET HEAD
		path /
	}
	handle @root_get {
		reverse_proxy 127.0.0.1:3000
	}

	# Default catch-all for unknown routes
	handle {
		respond "Not Found" 404
	}
}
