#!/usr/bin/env bash

# ==============================================================================
# Rust Pre-Commit Hook (Powered by Charm Gum)
# Formats, auto-fixes clippy warnings, stages changes, and renders a card UI.
# ==============================================================================

set -euo pipefail

# Ensure gum is installed
if ! command -v gum &> /dev/null; then
  echo "Error: 'gum' is not installed. Run 'brew install gum'." >&2
  exit 1
fi

# ------------------------------------------------------------------------------
# Active Progress (Spinners)
# ------------------------------------------------------------------------------
echo ""
gum spin --spinner dot --title " [1/3] Formatting codebase with cargo fmt..." -- \
  cargo fmt

gum spin --spinner dot --title " [2/3] Applying eligible Clippy fixes..." -- \
  cargo clippy --fix --allow-dirty --allow-staged

gum spin --spinner dot --title " [3/3] Re-staging modified files into git..." -- \
  git add -u

# ------------------------------------------------------------------------------
# Pre-Commit Summary Card
# ------------------------------------------------------------------------------
gum style \
  --border rounded \
  --border-foreground 99 \
  --padding "1 2" \
  --margin "1 0 1 0" \
  --width 62 \
  "$(gum style --bold --foreground 212 '🦀 vox-bridge') $(gum style --foreground 245 '• Pre-Commit Hook')" \
  "$(gum style --foreground 239 '──────────────────────────────────────────────────────────')" \
  " $(gum style --foreground 82 '✔') $(gum style --bold 'cargo fmt')        $(gum style --foreground 246 'Code formatted according to style guide')" \
  " $(gum style --foreground 82 '✔') $(gum style --bold 'cargo clippy')     $(gum style --foreground 246 'Eligible lints automatically fixed')" \
  " $(gum style --foreground 82 '✔') $(gum style --bold 'git add')          $(gum style --foreground 246 'Modified files re-staged into git index')" \
  "$(gum style --foreground 239 '──────────────────────────────────────────────────────────')" \
  "$(gum style --bold --foreground 82 '✨ Ready to commit!') $(gum style --foreground 245 'All checks passed cleanly.')"
