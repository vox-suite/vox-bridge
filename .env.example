# WhatsApp phone verification through Twilio. TWILIO_WHATSAPP_FROM is the registered
# WhatsApp sender; TWILIO_OTP_CONTENT_SID is the HX... id of the approved
# "WhatsApp authentication" template created in Twilio's Content Template Builder.
TWILIO_WHATSAPP_FROM=+14155550123
TWILIO_OTP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
